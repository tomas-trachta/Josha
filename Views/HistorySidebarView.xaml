<UserControl x:Class="Josha.Views.HistorySidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Josha.ViewModels"
             xmlns:models="clr-namespace:Josha.Models"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppShellViewModel}"
             d:DesignWidth="230" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="HistoryListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="5"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSubtle}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceSubtle}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceDisabled}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="HistoryEntryTemplate" DataType="{x:Type models:NavigationHistoryEntry}">
            <Grid ToolTip="{Binding TargetPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconMaterial Grid.Column="0"
                                            Kind="FolderOutline"
                                            Foreground="{StaticResource Brush.RowFolder}"
                                            Width="14" Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="12.5"
                               Foreground="{StaticResource Brush.OnSurface}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TargetPath}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.OnSurfaceMuted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.SurfaceMuted}"
            BorderBrush="{StaticResource Brush.OutlineSubtle}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="False"
                       Margin="6,8,6,4">
                <TextBlock DockPanel.Dock="Left"
                           Text="EXPLORER"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.OnSurfaceSubtle}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right"
                        x:Name="ToggleExpandButton"
                        Click="OnToggleExpandClick"
                        Width="20" Height="20"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Collapse / expand sidebar"
                        VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Width="14" Height="14"
                                                Foreground="{StaticResource Brush.OnSurfaceMuted}">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="ChevronDoubleLeft"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Kind" Value="ChevronDoubleRight"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                </Button>
            </DockPanel>

            <Grid x:Name="Body"
                  Grid.Row="1"
                  Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="10,10,10,5"
                    BorderBrush="{StaticResource Brush.Outline}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource Brush.SurfaceElevated}">
                <DockPanel LastChildFill="True" Margin="8">
                    <DockPanel.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}"/>
                    </DockPanel.Resources>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="History"
                                                        Width="13" Height="13"
                                                        Margin="0,0,6,0"
                                                        Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                            <TextBlock Text="HISTORY"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox x:Name="RecentList"
                                 Style="{StaticResource HistoryListBoxStyle}"
                                 ItemsSource="{Binding RecentHistory}"
                                 ItemTemplate="{StaticResource HistoryEntryTemplate}"
                                 MouseDoubleClick="OnRowDoubleClick"
                                 KeyDown="OnListKeyDown"
                                 PreviewMouseRightButtonUp="OnRowPreviewMouseRightButtonUp"/>
                        <TextBlock Text="No directories visited yet"
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding RecentHistory.Count, Converter={StaticResource ZeroToVisible}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="10,5,10,10"
                    BorderBrush="{StaticResource Brush.Outline}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource Brush.SurfaceElevated}">
                <DockPanel LastChildFill="True" Margin="8">
                    <DockPanel.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}"/>
                    </DockPanel.Resources>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Star"
                                                        Width="13" Height="13"
                                                        Margin="0,0,6,0"
                                                        Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                            <TextBlock Text="MOST VISITED"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox x:Name="MostVisitedList"
                                 Style="{StaticResource HistoryListBoxStyle}"
                                 ItemsSource="{Binding MostVisitedHistory}"
                                 ItemTemplate="{StaticResource HistoryEntryTemplate}"
                                 MouseDoubleClick="OnRowDoubleClick"
                                 KeyDown="OnListKeyDown"
                                 PreviewMouseRightButtonUp="OnRowPreviewMouseRightButtonUp"/>
                        <TextBlock Text="No directories visited yet"
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding MostVisitedHistory.Count, Converter={StaticResource ZeroToVisible}}"/>
                    </Grid>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
