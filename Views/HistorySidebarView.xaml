<UserControl x:Class="Josha.Views.HistorySidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Josha.ViewModels"
             xmlns:models="clr-namespace:Josha.Models"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppShellViewModel}"
             d:DesignWidth="230" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="HistoryListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSubtle}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceSubtle}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceDisabled}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="HistoryEntryTemplate" DataType="{x:Type models:NavigationHistoryEntry}">
            <Grid ToolTip="{Binding TargetPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconMaterial Grid.Column="0"
                                            Kind="FolderOutline"
                                            Foreground="{StaticResource Brush.RowFolder}"
                                            Width="14" Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="12.5"
                               Foreground="{StaticResource Brush.OnSurface}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TargetPath}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.OnSurfaceMuted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RemoteHistoryEntryTemplate" DataType="{x:Type models:RemoteHistoryEntry}">
            <Grid ToolTip="{Binding SiteAndPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconMaterial Grid.Column="0"
                                            Kind="Server"
                                            Foreground="{StaticResource Brush.RowFolder}"
                                            Width="14" Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="12.5"
                               Foreground="{StaticResource Brush.OnSurface}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SiteAndPath}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.OnSurfaceMuted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.OutlineSubtle}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="False"
                       Margin="6,8,6,4">
                <TextBlock DockPanel.Dock="Left"
                           Text="EXPLORER"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.OnSurfaceSubtle}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right"
                        x:Name="ToggleExpandButton"
                        Click="OnToggleExpandClick"
                        Width="24" Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Collapse / expand sidebar"
                        VerticalAlignment="Center">
                    <!-- Circular hover target, matching every other toolbar
                         icon button in the app (IconButtonStyle) instead of a
                         bare glyph with no feedback shape of its own. -->
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfacePressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <iconPacks:PackIconMaterial Width="14" Height="14"
                                                Foreground="{StaticResource Brush.OnSurfaceMuted}">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="ChevronDoubleLeft"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Kind" Value="ChevronDoubleRight"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                </Button>
            </DockPanel>

            <Grid x:Name="Body"
                  Grid.Row="1"
                  Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <!-- Flat sections instead of individually-boxed cards — a hairline
                 rule under the header and the shared surface color are enough
                 to separate them, matching how the rest of the shell (toolbar,
                 drive bar, path bar) reads as one continuous surface rather
                 than a stack of nested panels. -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="4,10,4,6">
                <Border DockPanel.Dock="Top" Margin="8,0,8,8"
                        Padding="0,0,0,6"
                        BorderBrush="{StaticResource Brush.OutlineSubtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="History"
                                                    Width="13" Height="13"
                                                    Margin="0,0,6,0"
                                                    Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                        <TextBlock Text="HISTORY" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="RecentList"
                             Style="{StaticResource HistoryListBoxStyle}"
                             ItemsSource="{Binding RecentHistory}"
                             ItemTemplate="{StaticResource HistoryEntryTemplate}"
                             MouseDoubleClick="OnRowDoubleClick"
                             KeyDown="OnListKeyDown"
                             PreviewMouseRightButtonUp="OnRowPreviewMouseRightButtonUp"/>
                    <TextBlock Text="No directories visited yet"
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding RecentHistory.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </DockPanel>

            <DockPanel Grid.Row="1" LastChildFill="True" Margin="4,6,4,6">
                <Border DockPanel.Dock="Top" Margin="8,0,8,8"
                        Padding="0,0,0,6"
                        BorderBrush="{StaticResource Brush.OutlineSubtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Star"
                                                    Width="13" Height="13"
                                                    Margin="0,0,6,0"
                                                    Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                        <TextBlock Text="MOST VISITED" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="MostVisitedList"
                             Style="{StaticResource HistoryListBoxStyle}"
                             ItemsSource="{Binding MostVisitedHistory}"
                             ItemTemplate="{StaticResource HistoryEntryTemplate}"
                             MouseDoubleClick="OnRowDoubleClick"
                             KeyDown="OnListKeyDown"
                             PreviewMouseRightButtonUp="OnRowPreviewMouseRightButtonUp"/>
                    <TextBlock Text="No directories visited yet"
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding MostVisitedHistory.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </DockPanel>

            <DockPanel Grid.Row="2" LastChildFill="True" Margin="4,6,4,10">
                <Border DockPanel.Dock="Top" Margin="8,0,8,8"
                        Padding="0,0,0,6"
                        BorderBrush="{StaticResource Brush.OutlineSubtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Server"
                                                    Width="13" Height="13"
                                                    Margin="0,0,6,0"
                                                    Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                        <TextBlock Text="REMOTE DIRECTORIES" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="RemoteHistoryList"
                             Style="{StaticResource HistoryListBoxStyle}"
                             ItemsSource="{Binding RemoteDirectoryHistory}"
                             ItemTemplate="{StaticResource RemoteHistoryEntryTemplate}"
                             MouseDoubleClick="OnRowDoubleClick"
                             KeyDown="OnListKeyDown"/>
                    <TextBlock Text="No remote directories visited yet"
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding RemoteDirectoryHistory.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </DockPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
