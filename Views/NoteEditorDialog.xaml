<Window x:Class="Josha.Views.NoteEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Note"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource Brush.OnSurface}"
        FontFamily="{DynamicResource Font.Body}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close"/>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCancelCommand"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveCommand"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Top-aligned multiline variant of ModernTextBoxStyle — the shared
             style centers content vertically, which reads fine for a single
             line but leaves short notes floating mid-box here. -->
        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.OnSurface}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentSoft}"/>
            <Setter Property="SelectionOpacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    CornerRadius="12"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock x:Name="Watermark"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource Brush.OnSurfaceSubtle}"
                                               FontFamily="{DynamicResource Font.Body}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Margin="{TemplateBinding Padding}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  Focusable="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.OutlineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Same floating-card chrome as BookmarksDialog / CommandPalette
         (borderless window, rounded card, bloom-in on open) — every modal in
         the app reads as one family instead of a mix of native and custom
         dialog styling. -->
    <Border Background="{StaticResource Brush.SurfaceElevated}"
            BorderBrush="{StaticResource Brush.Outline}"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource Elevation.3}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                          From="0" To="1" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                          From="0.96" To="1" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                          From="0.96" To="1" Duration="0:0:0.16"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,16"
                    BorderBrush="{StaticResource Brush.OutlineSubtle}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="NoteTextOutline"
                                                Width="16" Height="16"
                                                Margin="0,0,12,0"
                                                Foreground="{StaticResource Brush.Accent}"
                                                VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Note"
                                   FontSize="17"/>
                        <TextBlock x:Name="PathText"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.OnSurfaceMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBox x:Name="NoteBox"
                     Grid.Row="1"
                     Style="{StaticResource NoteTextBoxStyle}"
                     Tag="Write a note…"
                     Height="200"
                     Margin="18,16"
                     VerticalScrollBarVisibility="Auto"/>

            <Border Grid.Row="2"
                    Padding="18,10"
                    Background="{StaticResource Brush.SurfaceMuted}"
                    BorderBrush="{StaticResource Brush.OutlineSubtle}"
                    BorderThickness="0,1,0,0">
                <TextBlock Foreground="{StaticResource Brush.OnSurfaceSubtle}"
                           FontSize="11">
                    <Run Text="Ctrl+Enter save"/>
                    <Run Text="·" Foreground="{StaticResource Brush.OutlineStrong}"/>
                    <Run Text="Esc cancel"/>
                </TextBlock>
            </Border>

            <Border Grid.Row="3"
                    Padding="18,14"
                    Background="{StaticResource Brush.SurfaceMuted}"
                    CornerRadius="0,0,14,14">
                <DockPanel LastChildFill="False">
                    <Button x:Name="DeleteButton"
                            DockPanel.Dock="Left"
                            Content="Delete note"
                            Click="OnDelete"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{StaticResource Brush.Toast.Error}"
                            MinWidth="100"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" Click="OnCancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="90" Margin="0,0,8,0"/>
                        <Button Content="Save" Click="OnSave"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="90" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
