<UserControl x:Class="Josha.Views.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Josha.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppShellViewModel}"
             d:DesignHeight="28" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="UsagePillStyle" TargetType="Border">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UsageTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI"/>
        </Style>
        <Style x:Key="UsageLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceSubtle}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource Brush.SurfaceMuted}"
            BorderBrush="{StaticResource Brush.OutlineSubtle}"
            BorderThickness="0,1,0,0"
            Padding="10,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding ActivePane.SelectionStatus}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.OnSurface}"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Padding="6,1"
                    CornerRadius="3"
                    Background="{StaticResource Brush.SurfaceElevated}"
                    BorderBrush="{StaticResource Brush.OutlineSubtle}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    ToolTip="Click a column header to change sort">
                <TextBlock Text="{Binding ActivePane.SortStatus}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.OnSurfaceMuted}"/>
            </Border>

            <TextBlock Grid.Column="2"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.OnSurfaceMuted}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="16,0"/>

            <local:QueueStatusPill Grid.Column="3"
                                   xmlns:local="clr-namespace:Josha.Views"
                                   Margin="0,0,12,0"/>

            <TextBlock Grid.Column="4"
                       Text="{Binding ActivePane.FreeSpaceStatus}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.OnSurfaceMuted}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        Margin="14,0,0,0">
                <Border Style="{StaticResource UsagePillStyle}" Margin="0" ToolTip="CPU usage">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Cpu64Bit"
                                                    Width="12" Height="12"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                        <TextBlock Style="{StaticResource UsageLabelStyle}" Text="CPU"/>
                        <TextBlock Style="{StaticResource UsageTextStyle}"
                                   Text="{Binding CpuUsagePercent, StringFormat={}{0:0}%}"
                                   Foreground="{Binding CpuUsagePercent, Converter={StaticResource UsagePercentToBrush}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource UsagePillStyle}" ToolTip="Memory usage">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Memory"
                                                    Width="12" Height="12"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource Brush.OnSurfaceSubtle}"/>
                        <TextBlock Style="{StaticResource UsageLabelStyle}" Text="MEM"/>
                        <TextBlock Style="{StaticResource UsageTextStyle}"
                                   Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}%}"
                                   Foreground="{Binding MemoryUsagePercent, Converter={StaticResource UsagePercentToBrush}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="6"
                       Text="{Binding Clock}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.OnSurface}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"
                       FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
        </Grid>
    </Border>
</UserControl>
