<Window x:Class="Josha.Views.OpenWithDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Open with"
        Width="360" SizeToContent="Height"
        MaxHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.OnSurface}"
        FontFamily="{DynamicResource Font.Body}">
    <Window.Resources>
        <Style x:Key="HandlerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCancelCommand"/>
    </Window.CommandBindings>

    <StackPanel Margin="20">
        <TextBlock Text="Choose an app — it opens both the commit's version and the current version, so editors that reuse a window show them as two tabs."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.OnSurfaceMuted}"
                   Margin="0,0,0,12"/>

        <ListBox x:Name="HandlerList"
                 MaxHeight="320"
                 Background="{StaticResource Brush.SurfaceMuted}"
                 Foreground="{StaticResource Brush.OnSurface}"
                 BorderBrush="{StaticResource Brush.OutlineSubtle}"
                 BorderThickness="1"
                 ItemContainerStyle="{StaticResource HandlerItemStyle}"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}"
                               Width="20" Height="20"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.OnSurface}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Open" Click="OnOk"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="90" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
