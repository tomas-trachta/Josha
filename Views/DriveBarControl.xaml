<UserControl x:Class="Josha.Views.DriveBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Josha.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilePaneViewModel}"
             d:DesignHeight="34" d:DesignWidth="500">
    <UserControl.Resources>
        <Style x:Key="DriveChipStyle" TargetType="Button">
            <!-- Fixed and equal Width/Height so CornerRadius="15" (half the
                 side length) always draws a true circle. MinWidth alone with
                 padding-driven height produced a slightly wider-than-tall
                 pill instead — the corner arcs weren't symmetric, so a
                 dead-center letter still read as off-center. -->
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnSurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.OutlineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfacePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.SurfaceMuted}"
            BorderBrush="{StaticResource Brush.OutlineSubtle}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
        <ItemsControl x:Name="DriveItems">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- An explicit TextBlock instead of a raw string Content:
                         Button wraps string content in AccessText, which
                         reserves layout space for a potential mnemonic
                         underline and renders single glyphs like "C"/"G"
                         slightly off-center inside a circular chip. -->
                    <Button Tag="{Binding Letter}"
                            Click="OnDriveClick"
                            ToolTip="{Binding Tooltip}">
                        <!-- Small manual optical correction: Segoe UI's side
                             bearing + line-box ascent/descent placement for a
                             single glyph like "C"/"G" sits left-and-up of true
                             geometric center by about a pixel — measured
                             directly against the circle, not guessed. -->
                        <TextBlock Text="{Binding Letter}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="1,1,0,0"/>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DriveChipStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.AccentSubtle}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
